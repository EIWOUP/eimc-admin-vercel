# Copy to .env.local for local testing. On Vercel, add these in Project → Settings → Environment Variables.

# The same database as eimc.vercel.app (Neon pooled URL on Vercel, local Postgres on this PC)
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/eimc

# Admin sign-in
ADMIN_ID=your-admin-id
ADMIN_PASSWORD=a-long-password
# 32+ random characters; signs the session cookie. Changing it signs every admin out.
ADMIN_SECRET=

# EIMC Terminal market data. 32+ random characters; encrypts the house Dhan token in the database.
# The relay server must use the SAME value. Changing it means pasting the Dhan token again.
EIMC_BROKER_KEY=
# The relay server, once it runs (Market data page shows its health). RELAY_ADMIN_TOKEN is shared with the relay.
# RELAY_URL=https://relay.example.com
# RELAY_ADMIN_TOKEN=

# Email (optional). Without one of these, emails are saved to the user's notifications but not delivered.
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM=EIMC <support@eimc.app>
